# Dibs settings that must stay off GitHub. Copy this file to .env.local and
# fill in the values there. Never put a real value in this file.

# --- Database (Start lane) ---
# Empty = an embedded Postgres kept in a local folder, nothing to install.
# Set = the address of a hosted Postgres (used when Dibs is put online).
DATABASE_URL=
# Folder for the embedded Postgres. Empty = .data/pglite.
# Each lane running at the same time uses its own, e.g. .data/lane-a
DIBS_DATA_DIR=
# Folder for Next.js build files. Empty = .next.
# Each lane running at the same time uses its own: .next-a, .next-b, .next-c, .next-d
DIBS_DIST_DIR=

# --- The site's own address (lanes A, B, D) ---
# Where Dibs is reached, with no slash at the end. Used for tracked links and
# for PayPal sending the poster back. On a laptop: http://localhost:3000
DIBS_BASE_URL=

# --- PayPal, test mode only (lane A) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal's address for test mode. Empty = https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=
# The number PayPal gives the address it tells about sales (its "webhook id").
PAYPAL_WEBHOOK_ID=
# 1 = show "Log in with PayPal" (needs the feature ticked on the PayPal app, and
# the return address registered there). Empty = only joining by email shows.
PAYPAL_LOGIN_ON=
# Pretend people from PayPal's developer page.
PAYPAL_TEST_BUYER_EMAIL=
PAYPAL_TEST_WORKER_EMAIL=
PAYPAL_TEST_WORKER2_EMAIL=

# --- AI and video site keys (lane B) ---
GOOGLE_AI_API_KEY=
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a separate Google AI key just for the Ledger's ask box, so its
# questions never use up the calls the checks need. Empty = GOOGLE_AI_API_KEY is used.
LEDGER_AI_API_KEY=

# --- Only when Dibs is online on Render (lane B) ---
# Folder where files that workers hand in are kept. Empty = a folder inside the project.
DIBS_FILES_DIR=
# The site's inside address on Render (host:port), so the timer can fetch handed-in
# files from the site. Render fills this in by itself. Empty = the public address is used.
DIBS_WEB_HOSTPORT=
# 1 = slow checks (AI watching a video) are handed to Render's background tasks.
# Empty = the timer does every check itself. Needs the two names below as well.
DIBS_CHECKS_ON_RENDER=
# A key from Render, so the timer may start background tasks.
RENDER_API_KEY=
# The name of the background-task service on Render.
DIBS_CHECKS_WORKFLOW=

# --- The outside timer (lanes B, D) ---
# A made-up password the timer sends when it calls the "run checks" address,
# so strangers cannot trigger it.
TICK_SECRET=

# 1 = Dibs may open web pages on this machine (for trying the page check on a laptop). Never set it online.
DIBS_ALLOW_LOCAL_PAGES=
