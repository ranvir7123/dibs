# Dibs settings that must stay off GitHub. Copy this file to .env.local and
# fill in the values there. Never put a real value in this file.

# --- Database (Start lane) ---
# Empty = an embedded Postgres kept in a local folder, nothing to install.
# Set = the address of a hosted Postgres (used when Dibs is put online).
DATABASE_URL=
# Folder for the embedded Postgres. Empty = .data/pglite.
# Each lane running at the same time uses its own, e.g. .data/lane-a
DIBS_DATA_DIR=
# Folder for Next.js build files. Empty = .next.
# Each lane running at the same time uses its own: .next-a, .next-b, .next-c, .next-d
DIBS_DIST_DIR=

# --- The site's own address (lanes A, B, D) ---
# Where Dibs is reached, with no slash at the end. Used for tracked links and
# for PayPal sending the poster back. On a laptop: http://localhost:3000
DIBS_BASE_URL=

# --- PayPal, test mode only (lane A) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal's address for test mode. Empty = https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=
# The number PayPal gives the address it tells about sales (its "webhook id").
PAYPAL_WEBHOOK_ID=
# Pretend people from PayPal's developer page.
PAYPAL_TEST_BUYER_EMAIL=
PAYPAL_TEST_WORKER_EMAIL=
PAYPAL_TEST_WORKER2_EMAIL=

# --- AI and video site keys (lane B) ---
GOOGLE_AI_API_KEY=
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=

# --- The outside timer (lanes B, D) ---
# A made-up password the timer sends when it calls the "run checks" address,
# so strangers cannot trigger it.
TICK_SECRET=
